# Agent / AI editor instructions
AGENTS.md

# Generated by AzOS/tools/export_kernel_consts.py
# (kernel↔brain const bridge per RFC-0026).  Regenerate from the
# kernel-side .config; do not edit by hand.
protocol_consts.py

# Local bench_e2e measurement artifacts (reproducible; the regression gate
# lives in bench/baselines.json, which IS versioned). One representative
# sample is kept tracked; add new ones with `git add -f` if needed.
bench/results/*.json

# Learned planner heuristics — RUNTIME OUTPUT, not source.
#
# `planner/meta.py` writes these as the meta-reviewer learns. The copy that
# used to be committed here was not learned anything: it held
# `"rule": "rule one", "reason": "r"`, i.e. `tests/test_meta.py`'s fixtures,
# because the save path was a module global and only one test redirected it.
# Removed 2026-09-09 along with that seam.
data/experience/*.json

# Local-only documentation. README.md is the only public documentation;
# these stay on disk for the maintainer and are never committed.
/docs/
/bench/README.md
/tools/SOAK_BASELINE.md
